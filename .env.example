# Postgres connection string. Use a direct (non-pooled) URL, e.g. from Neon with "Connection pooling" turned off.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Long random string used to sign login sessions. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
# Comma-separated emails that get the admin role when they sign up
ADMIN_EMAILS=""
