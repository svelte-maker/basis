// Postgres everywhere (Neon or Supabase in production, any Postgres locally).
// DATABASE_URL must be a direct (non-pooled) connection string.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  handle         String   @unique
  name           String
  email          String   @unique
  passwordHash   String
  role           String   @default("MEMBER") // MEMBER | RECRUITER | ADMIN
  headline       String   @default("")
  location       String   @default("")
  bio            String   @default("")
  company        String   @default("") // recruiters
  openToWork     Boolean  @default(true)
  credentialId   String   @unique
  glickoRating   Float    @default(1200)
  glickoRd       Float    @default(350)
  glickoVol      Float    @default(0.06)
  practicePoints Int      @default(0)
  ratedContests  Int      @default(0)
  createdAt      DateTime @default(now())

  practice     PracticeState[]
  submissions  Submission[]
  ratingEvents RatingEvent[]
  entries      ContestEntry[]
  posts        Post[]
  comments     Comment[]
  votes        Vote[]
  shortlisted  Shortlist[]     @relation("recruiter")
  shortlistedBy Shortlist[]    @relation("candidate")
  modelStates   ModelState[]
  modelSubmissions ModelSubmission[]
  teamsCreated  Team[]
  teamMembers   TeamMember[]
  teamCells     TeamCell[]
}

model PracticeState {
  id        String    @id @default(cuid())
  userId    String
  slug      String
  variant   Int       @default(0)
  attempts  Int       @default(0)
  solved    Boolean   @default(false)
  revealed  Boolean   @default(false) // solution viewed before solving: no points for this variant
  everSolved Boolean  @default(false)
  solvedAt  DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
}

model Submission {
  id        String   @id @default(cuid())
  userId    String
  slug      String
  seed      String
  input     String
  correct   Boolean
  contestId String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contest   Contest? @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@index([userId, slug])
  @@index([contestId, userId])
}

model RatingEvent {
  id          String   @id @default(cuid())
  userId      String
  kind        String // contest | practice
  delta       Int
  ratingAfter Int
  note        String
  contestId   String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Contest {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  description  String    @default("")
  startsAt     DateTime
  endsAt       DateTime
  rated        Boolean   @default(true)
  problemSlugs String // JSON array of template slugs
  finalizedAt  DateTime?
  createdAt    DateTime  @default(now())

  entries     ContestEntry[]
  submissions Submission[]
}

model ContestEntry {
  id           String   @id @default(cuid())
  contestId    String
  userId       String
  registeredAt DateTime @default(now())
  score        Int      @default(0)
  solvedCount  Int      @default(0)
  lastSolveMin Int      @default(0)
  rank         Int?
  ratingBefore Int?
  ratingAfter  Int?
  contest      Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId])
}

model Post {
  id        String    @id @default(cuid())
  authorId  String
  kind      String // Model | Case write-up | Research | Question
  track     String    @default("")
  title     String
  body      String
  link      String    @default("")
  score     Int       @default(0)
  createdAt DateTime  @default(now())
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]
  votes     Vote[]

  @@index([createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Vote {
  userId String
  postId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model Shortlist {
  recruiterId String
  candidateId String
  note        String   @default("")
  createdAt   DateTime @default(now())
  recruiter   User     @relation("recruiter", fields: [recruiterId], references: [id], onDelete: Cascade)
  candidate   User     @relation("candidate", fields: [candidateId], references: [id], onDelete: Cascade)

  @@id([recruiterId, candidateId])
}

// Spreadsheet model tasks (src/lib/models). One row per person per task, like PracticeState,
// plus the work in progress so a long model survives a refresh.
model ModelState {
  id         String    @id @default(cuid())
  userId     String
  slug       String
  variant    Int       @default(0)
  draft      String    @default("{}") // JSON: address -> what they typed
  attempts   Int       @default(0)
  bestScore  Float     @default(0)
  solved     Boolean   @default(false)
  revealed   Boolean   @default(false) // answer model viewed before solving: no points for this variant
  everSolved Boolean   @default(false)
  solvedAt   DateTime?
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
}

model ModelSubmission {
  id        String   @id @default(cuid())
  userId    String
  slug      String
  seed      String
  cells     String // JSON: address -> what they typed
  score     Float // share of graded points earned, 0 to 1
  report    String // JSON GradeReport
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, slug])
}

// Team solving (src/lib/teams): several people build one model task, each owning a part.
model Team {
  id          String       @id @default(cuid())
  slug        String // model task
  name        String
  createdById String
  createdAt   DateTime     @default(now())
  deadline    DateTime
  finalizedAt DateTime?
  teamScore   Float? // the whole joined-up model, 0 to 1
  result      String? // JSON TeamResult summary, written once at finalize
  createdBy   User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  members     TeamMember[]
  parts       TeamPart[]
  cells       TeamCell[]

  @@index([slug, finalizedAt])
}

model TeamMember {
  teamId       String
  userId       String
  joinedAt     DateTime @default(now())
  ready        Boolean  @default(false)
  points       Int      @default(0)
  contribution Float    @default(0) // share of the task's checked points this person wrote, 0 to 1
  credited     Boolean  @default(false) // earned points on this task; a person is credited once per task
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
}

model TeamPart {
  teamId      String
  key         String
  claimedById String?
  claimedAt   DateTime?
  lastEditAt  DateTime?
  score       Float? // graded on its own at finalize
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([teamId, key])
}

model TeamCell {
  teamId    String
  addr      String
  value     String
  authorId  String
  updatedAt DateTime @updatedAt
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([teamId, addr])
}
